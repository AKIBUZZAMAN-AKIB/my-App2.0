{
  "$schema": "./app.config.schema.json",
  "app": {
    "name": "My App",
    "id": "com.myapp.suite",
    "versionName": "1.0.0",
    "versionCode": 1,
    "buildNumber": "1",
    "description": "One home for every mini app on this device: Home, Academic, Agent, Calendar and More.",
    "defaultLanguage": "en",
    "urlScheme": "myapp"
  },
  "web": {
    "mode": "static",
    "staticDir": "www",
    "framework": {
      "workDir": "web-source",
      "buildCommand": "npm ci && npm run build",
      "outputDir": "dist"
    },
    "nativeStagingDir": ".nativekit/staged-www",
    "webOutputDir": "web-dist",
    "injectBridge": true,
    "serviceWorker": {
      "enabledForWebTarget": true,
      "cacheName": "nativekit-web-v1",
      "offlineFallback": "index.html"
    }
  },
  "network": {
    "nativeHttp": true,
    "patchFetch": true,
    "patchXMLHttpRequest": true,
    "allowCleartext": false,
    "allowedHostnames": [],
    "connectTimeoutMs": 30000,
    "readTimeoutMs": 120000
  },
  "features": {
    "camera": true,
    "location": true,
    "backgroundLocation": true,
    "haptics": true,
    "localNotifications": true,
    "pushNotificationsReady": true,
    "advancedAlarms": true,
    "backgroundRunner": true,
    "sqlite": true,
    "secureStorage": true,
    "filesystem": true,
    "fileTransfer": true,
    "sharing": true,
    "networkStatus": true,
    "nativeSSE": true,
    "appBrowser": true,
    "inAppBrowser": true,
    "preferences": true,
    "nearby": true,
    "widget": true,
    "agent": true
  },
  "permissions": {
    "camera": "Camera access is needed to attach a photo or video.",
    "photos": "Photo library access is needed to attach the pictures you pick.",
    "locationWhenInUse": "Your location is used for nearby features and the weather card.",
    "locationAlways": "Background location keeps a tracking session running while the app is not open.",
    "notifications": "Notifications deliver reminders, alarms and completed background runs.",
    "alarmKit": "System alarm access is needed so your alarms ring at the exact minute you set."
  },
  "android": {
    "minSdk": 24,
    "targetSdk": 36,
    "compileSdk": 36,
    "exactAlarmPermissionMode": "schedule",
    "fullScreenAlarm": true,
    "backgroundLocationForegroundService": true,
    "alarmSoundName": "default",
    "notificationChannelId": "myapp_general",
    "alarmChannelId": "myapp_alarms"
  },
  "ios": {
    "deploymentTarget": "15.0",
    "teamId": "",
    "alarmKitOnIOS26": false,
    "backgroundFetch": true,
    "backgroundProcessing": true,
    "backgroundLocation": true,
    "pushCapabilityConfigured": false
  },
  "appBrowser": {
    "enabled": true,
    "maxApps": 20,
    "maxPackageBytes": 15728640,
    "maxFiles": 500,
    "auditLogLimit": 2000,
    "maxRequestsPerMinute": 120,
    "maxActiveHomeWidgets": 8,
    "defaultCapabilities": [],
    "permissionPrompts": {
      "enabled": true,
      "requestTimeoutMs": 90000,
      "requestedCapabilityDefault": "ask",
      "unrequestedCapabilityDefault": "block"
    },
    "allowDirectWebNetwork": false,
    "urlMode": {
      "enabled": true,
      "allowedHosts": []
    },
    "renderer": "isolated",
    "isolated": {
      "enabled": true,
      "fallbackToIframe": true,
      "stageChunkBytes": 262144,
      "androidMinApi": 28,
      "hangTerminationDelayMs": 4000
    }
  },
  "backgroundRunner": {
    "label": "com.myapp.suite.background",
    "event": "nativekit.sync",
    "repeat": true,
    "intervalMinutes": 15,
    "autoStart": true,
    "taskIdentifier": "com.myapp.suite.background",
    "defaultSyncUrl": ""
  },
  "agent": {
    "wakeIntervalMinutes": 30,
    "minWakeIntervalMinutes": 15,
    "surfacedLimit": 50,
    "markSurfacedRead": false
  },
  "widget": {
    "enabled": true,
    "homeScreen": {
      "enabled": true,
      "updatePeriodMinutes": 30,
      "resizeEnabled": true,
      "kinds": [
        {
          "id": "nativekit-widget",
          "label": "My App",
          "layout": "medium",
          "minWidthDp": 140,
          "minHeightDp": 140,
          "targetCellWidth": 2,
          "targetCellHeight": 2
        }
      ]
    },
    "floating": {
      "enabled": true,
      "title": "My App",
      "page": "public/widgets/floating.html",
      "width": 240,
      "height": 220,
      "startOnLaunch": false
    }
  },
  "security": {
    "trustedLocalContentOnly": true,
    "allowNavigation": [],
    "contentSecurityPolicy": "default-src 'self' data: blob:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; frame-src 'self' data: blob: https:; object-src 'none'; base-uri 'self'"
  }
}
